# Optional. App works without these keys using built-in farmer advice.
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...

# Optional official daily mandi prices from data.gov.in (AGMARKNET).
# Create an API key at https://data.gov.in/ and keep it private.
# Without this key, the market page labels its bundled prices as reference data.
# DATA_GOV_IN_API_KEY=your_data_gov_in_api_key
